#!/usr/bin/env bash
set -euo pipefail

RUNTIME_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLI_DIR="$RUNTIME_DIR/cli"
LIB_DIR="$RUNTIME_DIR/lib"

if PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  cd "$PROJECT_ROOT"
fi

export PATH="$RUNTIME_DIR/bin:$PATH"

usage() {
  cat <<'EOF'
usage: codeteam <command> [options]

  start [--model provider/model] '<objective>'
  goal <task> <goal-id> '<objective>' [--depends a,b]
  spawn <task> [--goal id] '<focus>'
  followup <task> <agent-id> '<focus>'
  resume <task> <agent-id> '<focus>'
  status <task>
  inspect <task> [--goal id|--commitment id|--receipt id]
  watch <task> [--since seq] [--idle seconds]  # continuous NDJSON; usage extends patience silently
  sub <task> [--since seq] [--timeout seconds]
  usage <task>
  finish <task> --status completed|blocked --summary '<result>' [--remaining '<work>']
  stop <task> [agent-id]

Execution-only helpers (inside an assigned Agent):
  evidence run|batch|log
  check source [paths...]
EOF
}

case "${1:-}" in
  evidence)
    if [[ -z "${CODEFLOW_RUN_ID:-}" ]]; then echo "codeteam: CODEFLOW_RUN_ID is not set" >&2; exit 1; fi
    shift
    exec bun "$CLI_DIR/evidence.ts" "$@"
    ;;
  check)
    if [[ -z "${CODEFLOW_RUN_ID:-}" ]]; then echo "codeteam: CODEFLOW_RUN_ID is not set" >&2; exit 1; fi
    if [[ "${2:-}" != "source" ]]; then
      echo "codeteam: error: check requires source" >&2
      exit 1
    fi
    shift 2
    exec bun "$LIB_DIR/source-safety.ts" "$@"
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  start|goal|spawn|followup|resume|status|inspect|watch|sub|usage|finish|stop) ;;
  *)
    usage >&2
    exit 1
    ;;
esac

# Provider credentials are inherited from the caller's exported shell
# environment; no command here sources a credential file.
case "$1" in
  sub|usage) exec bun "$CLI_DIR/outer.ts" "$@" ;;
esac
exec bun "$CLI_DIR/team.ts" "$@"
