#!/usr/bin/env bash
# Outer-ring CLI: everything about a Task as a whole.
#
# The runtime is global — it lives beside this script inside the installed
# skill, not inside the project being worked on. Only run artifacts land in the
# project, under .codeflow/runs/. That is why RUNTIME_DIR is resolved relative
# to this file while the working directory becomes the target repository root.
#
# This binary provides the single-executor baseline, metadata, and benchmark
# entrypoints. codeteam is the outer loop's asynchronous Agent control plane.
# Pi semantic actions live only in its three-action collaborate tool.
#
# Everything below is Bun: the extensions are TypeScript loaded without a build
# step, so a second runtime would only add a dependency and a cold start.
set -euo pipefail

RUNTIME_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLI_DIR="$RUNTIME_DIR/cli"
BENCHMARK_CLI="$(cd "$RUNTIME_DIR/.." && pwd)/benchmark/cli/benchmark.ts"
CODEFLOW_HOME="${CODEFLOW_HOME:-$HOME/.codeflow}"

usage() {
  cat <<'EOF'
usage: codeflow <command> [options]

  exec [--model <provider/model>] "<objective>"
                                    run one executor (no inner organization)
  resume <task-id>                  resume a stopped single-executor Task
  ls                                list Tasks: id, status, duration, objective
  sub <task-id> [--since <seq>]     subscribe to a Task's event stream
  goals <task-id>                   show reduced Task and Goal state
  usage <task-id>                   show per-turn and total model usage
  accounts add|list|use             register model accounts and select the active account
  audit <task-id> [--force]         gated audit of a blocked or stale Task
  stop <task-id>                    terminate a running Task
  benchmark run|report              SWE-bench Verified benchmark runs and reports
  benchmark prepare|evaluate        outer-managed candidate preparation/evaluation

Use codeteam for asynchronous assignment and Agent session reuse.

  --help, --version
EOF
}

# Run artifacts belong to the repository being changed, so every command
# operates from its root. Outside a repository the current directory is the
# project: codeflow never silently writes somewhere the user is not standing.
if PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  cd "$PROJECT_ROOT"
fi

export PATH="$RUNTIME_DIR/bin:$PATH"

# Metadata inspection and the pure-metadata commands must work without
# credentials configured, so they are dispatched before any env file is read.
case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  --version)
    exec bun "$CLI_DIR/run.ts" --version
    ;;
  debug)
    exec bun "$CLI_DIR/run.ts" "$@"
    ;;
  ls|sub|goals|usage|stop|audit)
    exec bun "$CLI_DIR/outer.ts" "$@"
    ;;
  accounts)
    shift
    exec bun "$CLI_DIR/accounts.ts" "$@"
    ;;
  benchmark)
    # Pure report/help/fixture paths need no provider environment. Real runs
    # continue below so the normal CODEFLOW_HOME/.env loading happens before
    # the benchmark driver computes the provider-network exemption set.
    if [[ "${2:-}" != "run" ]]; then
      exec bun "$BENCHMARK_CLI" "$@"
    fi
    for arg in "$@"; do
      case "$arg" in
        --fixture|-h|--help) exec bun "$BENCHMARK_CLI" "$@" ;;
      esac
    done
    ;;
esac

# Credentials come from the caller's exported shell environment, and from
# nowhere else. No launcher sources a file on disk: sourcing executes whatever
# that file contains, ties the keys in use to a global path instead of the shell
# that started the run, and hides a per-project override. Account pools name
# environment variables for the same reason.

case "${1:-}" in
  exec|resume)
    COMMAND="$1"
    shift
    exec bun "$CLI_DIR/run.ts" "$COMMAND" "$@"
    ;;
  benchmark)
    exec bun "$BENCHMARK_CLI" "$@"
    ;;
  *)
    if [[ -n "${1:-}" ]]; then
      echo "codeflow: error: unknown command: $1" >&2
    fi
    usage >&2
    exit 1
    ;;
esac
