#!/usr/bin/env python3
"""Codeflow pi runtime helper.

Maps Codeflow roles to real ``pi`` argv, and provides local ``debug`` and
``session`` compatibility subcommands. Reads only the project ``.codeflow/``
directory computed relative to this file so it works with an isolated HOME.

Subcommands:
  run --agent ROLE PROMPT... [--print] [--handoff-file PATH]
  debug agent [NAME]
  debug skill
  session list [--format json] [--limit N | -n N]
"""

import contextlib
import io
import json
import os
import secrets
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

CODEFLOW_DIR = Path(__file__).resolve().parents[1]
AGENTS_DIR = CODEFLOW_DIR / "agents"
SKILLS_DIR = CODEFLOW_DIR / "skills"
TASK_EXTENSION_PATH = CODEFLOW_DIR / "extensions" / "codeflow-task" / "index.ts"
CONTEXT_EXTENSION_PATH = CODEFLOW_DIR / "extensions" / "codeflow-context" / "index.ts"
WATCHDOG_EXTENSION_PATH = CODEFLOW_DIR / "extensions" / "agent-watchdog" / "index.ts"
HANDOFF_SCRIPTS_DIR = CODEFLOW_DIR / "skills" / "write-handoff" / "scripts"
SESSION_LIMIT_CAP = 10

# An installed runtime lives inside a business project; importing the shared
# handoff module must not litter it with bytecode caches.
sys.dont_write_bytecode = True
sys.path.insert(0, str(HANDOFF_SCRIPTS_DIR))
import handoff_state  # noqa: E402


def _new_run_id():
    """Sortable, lowercase, filesystem- and event-filename-safe."""
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    return f"run-{stamp}-{secrets.token_hex(2)}"


def _handoff_cli(argv):
    """Call the handoff CLI in-process, keeping its stdout off our stream."""
    buffer = io.StringIO()
    with contextlib.redirect_stdout(buffer):
        code = handoff_state.main(argv)
    if code != 0:
        return None
    try:
        return json.loads(buffer.getvalue() or "{}")
    except ValueError:
        return None


def _fail(message):
    print(f"pi-runtime: error: {message}", file=sys.stderr)
    return 1


def _read_agent_frontmatter(role):
    """Return the frontmatter mapping of agents/<role>.md.

    Returns None when the agent file does not exist so the caller can keep
    the standard ``unknown role`` failure. Agent Markdown frontmatter is the
    sole source of truth for role identity.
    """
    agent_path = AGENTS_DIR / f"{role}.md"
    if not agent_path.is_file():
        return None
    frontmatter = {}
    seen_open = False
    for line in agent_path.read_text(encoding="utf-8").splitlines():
        if line.strip() == "---":
            if seen_open:
                break
            seen_open = True
            continue
        if not seen_open:
            continue
        if ":" in line and not line.startswith((" ", "\t")):
            key, _, value = line.partition(":")
            frontmatter[key.strip()] = value.strip()
    return frontmatter


def _resolve_role(role):
    """Resolve a role to provider/model/system-prompt from its Markdown."""
    frontmatter = _read_agent_frontmatter(role)
    if frontmatter is None:
        return None
    model_value = frontmatter.get("model", "")
    if "/" not in model_value:
        raise SystemExit(
            _fail(f"agent {role}: frontmatter model must be '<provider>/<model>'")
        )
    provider, _, model = model_value.partition("/")
    tools = [
        token.strip()
        for token in frontmatter.get("tools", "").split(",")
        if token.strip()
    ]
    return {
        "system_prompt": AGENTS_DIR / f"{role}.md",
        "provider": provider,
        "model": model,
        "tools": tools,
    }


def _build_argv(entry, prompt):
    """The pi command line for one resolved role.

    Extensions are always loaded in the same order: delegation, context, then
    liveness. --no-context-files means nothing is picked up implicitly; the
    context extension injects rules and shared facts as a visible message.
    """
    argv = [
        "pi",
        "-p", prompt,
        "--mode", "json",
        "--provider", entry["provider"],
        "--model", entry["model"],
        "--system-prompt", str(entry["system_prompt"]),
        "--extension", str(TASK_EXTENSION_PATH),
        "--extension", str(CONTEXT_EXTENSION_PATH),
        "--extension", str(WATCHDOG_EXTENSION_PATH),
        "--no-context-files",
    ]
    if entry["tools"]:
        argv += ["--tools", ",".join(entry["tools"])]
    return argv


def cmd_run(args):
    role = None
    print_only = False
    handoff_file = None
    prompt_tokens = []
    i = 0
    while i < len(args):
        token = args[i]
        if token == "--agent":
            i += 1
            if i >= len(args):
                return _fail("--agent requires a role name")
            role = args[i]
        elif token == "--handoff-file":
            i += 1
            if i >= len(args):
                return _fail("--handoff-file requires a path")
            handoff_file = args[i]
        elif token == "--print":
            print_only = True
        else:
            prompt_tokens.append(token)
        i += 1

    if not role:
        return _fail("run requires --agent ROLE")
    prompt = " ".join(prompt_tokens)

    entry = _resolve_role(role)
    if entry is None:
        return _fail(f"unknown role: {role}")

    # A nested invocation stays inside the run that already exists; only a
    # fresh depth-0 start allocates a run-id and announces itself.
    run_id = os.environ.get("CODEFLOW_RUN_ID")
    fresh_run = run_id is None
    if fresh_run:
        run_id = _new_run_id()

    runs_dir = os.environ.get("CODEFLOW_RUNS_DIR", handoff_state.DEFAULT_RUNS_DIR)
    handoff_id = os.environ.get("CODEFLOW_HANDOFF_ID")

    # --print resolves the binding and exits. It must not register a run,
    # emit events, or create directories: diagnostics that leave artifacts
    # behind teach people to ignore artifacts.
    if print_only:
        print(
            json.dumps(
                {
                    "role": role,
                    "env": {
                        "CODEFLOW_AGENT_ROLE": role,
                        "CODEFLOW_AGENT_DEPTH": "0" if fresh_run else "1",
                        "CODEFLOW_RUN_ID": run_id,
                        **({"CODEFLOW_HANDOFF_ID": handoff_id} if handoff_id else {}),
                        "PI_CODING_AGENT_DIR": os.environ.get("PI_CODING_AGENT_DIR")
                        or str(CODEFLOW_DIR),
                    },
                    "argv": _build_argv(entry, prompt),
                }
            )
        )
        return 0

    if handoff_file:
        body = Path(handoff_file)
        if not body.is_file():
            return _fail(f"handoff body not found: {handoff_file}")
        opened = _handoff_cli(
            [
                "handoff", "open",
                "--run-id", run_id,
                "--runs-dir", runs_dir,
                "--role", role,
                "--depth", "0",
                "--body-file", str(body),
            ]
        )
        if opened is None:
            return _fail(f"could not register the root handoff from {handoff_file}")
        handoff_id = opened["handoff_id"]

    if fresh_run:
        _handoff_cli(
            [
                "handoff", "run-start",
                "--run-id", run_id,
                "--runs-dir", runs_dir,
                "--role", role,
                "--pid", str(os.getpid()),
            ]
        )

    print(
        f"codeflow run_id={run_id} "
        f"run_dir={Path(runs_dir) / run_id} "
        f"handoff_id={handoff_id or '-'}",
        file=sys.stderr,
    )

    argv = _build_argv(entry, prompt)
    role_env = {
        "CODEFLOW_AGENT_ROLE": role,
        "CODEFLOW_AGENT_DEPTH": "0" if fresh_run else "1",
        "CODEFLOW_RUN_ID": run_id,
    }
    if handoff_id:
        role_env["CODEFLOW_HANDOFF_ID"] = handoff_id

    os.environ.update(role_env)
    # Supervise pi as a child: spawn, wait, and reap it, then exit with
    # pi's exit code. Replacing this process with pi via exec would leave
    # nobody to reap pi (or anything it detaches), producing zombies.
    child = subprocess.Popen(argv)
    child.wait()
    return child.returncode


def _agent_metadata_lines(name):
    """Report agent identity from the Markdown frontmatter only."""
    frontmatter = _read_agent_frontmatter(name)
    lines = [f"agent: {name}"]
    lines.append(f"description: {frontmatter.get('description', '')}")
    lines.append(f"model: {frontmatter.get('model', '')}")
    if frontmatter.get("tools"):
        lines.append(f"tools: {frontmatter['tools']}")
    return lines


def cmd_debug(args):
    if not args:
        return _fail("debug requires a subcommand: agent | skill")
    sub, rest = args[0], args[1:]

    if sub == "skill":
        if not SKILLS_DIR.is_dir():
            return _fail(f"skills directory not found: {SKILLS_DIR}")
        for path in sorted(SKILLS_DIR.iterdir()):
            if path.is_dir():
                print(path.name)
        return 0

    if sub == "agent":
        if not rest:
            if not AGENTS_DIR.is_dir():
                return _fail(f"agents directory not found: {AGENTS_DIR}")
            for path in sorted(AGENTS_DIR.glob("*.md")):
                print(path.stem)
            return 0
        name = rest[0]
        agent_path = AGENTS_DIR / f"{name}.md"
        if not agent_path.is_file():
            return _fail(f"unknown agent: {name}")
        for line in _agent_metadata_lines(name):
            print(line)
        return 0

    return _fail(f"unknown debug subcommand: {sub}")


def _session_dir():
    env_dir = os.environ.get("CODEFLOW_PI_SESSION_DIR")
    if env_dir:
        return Path(env_dir)
    agent_dir = os.environ.get("PI_CODING_AGENT_DIR")
    if agent_dir:
        return Path(agent_dir) / "sessions"
    return Path.home() / ".pi" / "sessions"


def _cwd_session_dir(parent):
    cwd = os.getcwd()
    encoded = "--" + cwd.lstrip("/").replace("/", "-") + "--"
    return parent / encoded


def _parse_session_file(path):
    session_id = path.stem
    created = None
    model = None
    provider = None
    updated = None
    message_count = 0
    header_found = False
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    record = json.loads(line)
                except (json.JSONDecodeError, ValueError):
                    continue
                if not isinstance(record, dict):
                    continue
                rtype = record.get("type")
                ts = record.get("timestamp")
                if ts:
                    updated = ts
                if rtype == "session":
                    if not header_found:
                        session_id = record.get("id") or session_id
                        created = record.get("timestamp") or created
                        header_found = True
                if rtype == "model_change":
                    provider = record.get("provider") or provider
                    model = record.get("modelId") or model
                if rtype == "message":
                    message_count += 1
    except OSError:
        return None
    if not header_found:
        return None
    return {
        "id": session_id,
        "model": model,
        "provider": provider,
        "created": created,
        "updated": updated,
        "message_count": message_count,
    }


def cmd_session(args):
    if not args or args[0] != "list":
        return _fail("session requires the 'list' subcommand")
    rest = args[1:]

    fmt = "human"
    limit = SESSION_LIMIT_CAP
    i = 0
    while i < len(rest):
        token = rest[i]
        if token == "--format":
            i += 1
            if i >= len(rest):
                return _fail("--format requires a value")
            fmt = rest[i]
        elif token in ("--limit", "-n"):
            i += 1
            if i >= len(rest):
                return _fail(f"{token} requires a value")
            try:
                limit = int(rest[i])
            except ValueError:
                return _fail(f"invalid limit: {rest[i]}")
            if limit < 0:
                return _fail(f"limit must be non-negative: {limit}")
            if limit > SESSION_LIMIT_CAP:
                return _fail(f"limit {limit} exceeds cap {SESSION_LIMIT_CAP}")
        else:
            return _fail(f"unknown option: {token}")
        i += 1

    entries = []
    session_parent = _session_dir()
    cwd_dir = _cwd_session_dir(session_parent)
    if cwd_dir.is_dir():
        files = sorted(
            cwd_dir.glob("*.jsonl"),
            key=lambda p: p.stat().st_mtime,
            reverse=True,
        )
        for path in files[:limit]:
            entry = _parse_session_file(path)
            if entry is not None:
                entries.append(entry)

    if fmt == "json":
        print(json.dumps(entries))
    else:
        for entry in entries:
            print(
                "{id}  model={model} provider={provider} "
                "messages={message_count} updated={updated}".format(**entry)
            )
    return 0


def main(argv):
    if len(argv) < 2:
        return _fail("usage: pi-runtime <run|debug|session> ...")
    sub = argv[1]
    rest = argv[2:]
    if sub == "run":
        return cmd_run(rest)
    if sub == "debug":
        return cmd_debug(rest)
    if sub == "session":
        return cmd_session(rest)
    return _fail(f"unknown subcommand: {sub}")


if __name__ == "__main__":
    sys.exit(main(sys.argv))
