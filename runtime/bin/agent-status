#!/usr/bin/env python3
"""
codeflow agent-status — multi-source liveness probe for codeflow agents.

Why this exists
---------------
Outer coordinators have repeatedly misdiagnosed "agent is dead" from single
naive signals: an empty `ps aux | grep` (when ps is missing), a quiet log
file (when streaming-filter is suppressing deltas), or a stale=true handoff
(which is an age, not a verdict). This tool always cross-verifies at least
two independent signals before returning a verdict.

Signals used, in order of trustworthiness:

  1. /proc/<pid> directory exists         (Linux kernel process table)
  2. os.kill(pid, 0) succeeds             (POSIX signal probe)
  3. /proc/<pid>/cmdline contains "pi"    (defends against PID reuse)
  4. Watchdog heartbeat freshness         (liveness/<pid>--<role>--<depth>.json)

Verdicts:

  ALIVE    — signals 1+2+3 all pass (high confidence the process is running).
  DEAD     — signals 1+2 both fail (high confidence the process exited).
  UNKNOWN  — partial evidence, or non-Linux host where /proc is unavailable.

Exit codes:

  0 — every probed agent is ALIVE
  1 — at least one agent is DEAD
  2 — at least one agent is UNKNOWN (no DEAD)
  3 — usage error (no active runs, no such pid, bad args)

Usage:

  codeflow agent-status                       # all active runs
  codeflow agent-status --run-id <id>         # one run
  codeflow agent-status --pid <pid>           # one pid (any run)
  codeflow agent-status --format json|human   # default human
  codeflow agent-status --freshness <sec>     # heartbeat tolerance, default 180
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path

DEFAULT_FRESHNESS_SECONDS = 180.0
PROC_ROOT = Path("/proc")


@dataclass
class Verification:
    proc_pid_exists: bool | None = None
    kill_0_succeeded: bool | None = None
    cmdline_matches_pi: bool | None = None
    watchdog_heartbeat_fresh: bool | None = None

    def passed_signals(self) -> list[str]:
        out = []
        if self.proc_pid_exists:
            out.append("proc")
        if self.kill_0_succeeded:
            out.append("kill")
        if self.cmdline_matches_pi:
            out.append("cmdline")
        if self.watchdog_heartbeat_fresh:
            out.append("heartbeat")
        return out


@dataclass
class AgentProbe:
    run_id: str
    handoff_id: str
    role: str
    depth: int
    pid: int
    heartbeat_at: str | None = None
    heartbeat_age_seconds: float | None = None
    verification: Verification = field(default_factory=Verification)
    verdict: str = "UNKNOWN"

    def finalize_verdict(self) -> None:
        v = self.verification
        # High-confidence ALIVE: kernel table + signal probe + cmdline guard all pass.
        if v.proc_pid_exists and v.kill_0_succeeded and v.cmdline_matches_pi:
            self.verdict = "ALIVE"
            return
        # High-confidence DEAD: kernel table and signal probe both fail.
        if v.proc_pid_exists is False and v.kill_0_succeeded is False:
            self.verdict = "DEAD"
            return
        self.verdict = "UNKNOWN"


def _now_utc() -> datetime:
    return datetime.now(timezone.utc)


def _parse_iso(ts: str) -> datetime | None:
    try:
        if ts.endswith("Z"):
            ts = ts[:-1] + "+00:00"
        return datetime.fromisoformat(ts)
    except ValueError:
        return None


def _probe_proc(pid: int) -> tuple[bool | None, bool | None, bool | None]:
    """Return (proc_pid_exists, kill_0_succeeded, cmdline_matches_pi)."""
    if not PROC_ROOT.is_dir():
        # Non-Linux host: degrade to kill-0 only.
        try:
            os.kill(pid, 0)
            return (None, True, None)
        except ProcessLookupError:
            return (None, False, None)
        except PermissionError:
            return (None, True, None)
        except OSError:
            return (None, None, None)

    proc_dir = PROC_ROOT / str(pid)
    proc_exists = proc_dir.is_dir()

    try:
        os.kill(pid, 0)
        kill_ok = True
    except ProcessLookupError:
        kill_ok = False
    except PermissionError:
        kill_ok = True
    except OSError:
        kill_ok = proc_exists

    cmdline_ok: bool | None = None
    if proc_exists:
        try:
            cmdline = (proc_dir / "cmdline").read_bytes().decode("utf-8", errors="replace")
            cmdline_ok = "pi" in cmdline.split("\x00")[0] or "pi-coding-agent" in cmdline
        except OSError:
            cmdline_ok = None

    return (proc_exists, kill_ok, cmdline_ok)


def _scan_liveness(runs_dir: Path, run_id: str, freshness: float) -> list[AgentProbe]:
    """Scan a run's liveness directory for heartbeat records."""
    liveness_dir = runs_dir / run_id / "liveness"
    if not liveness_dir.is_dir():
        return []

    probes: list[AgentProbe] = []
    now = _now_utc()

    for heartbeat_file in sorted(liveness_dir.glob("*.json")):
        try:
            record = json.loads(heartbeat_file.read_text())
        except (OSError, json.JSONDecodeError):
            continue

        pid = record.get("pid")
        if not isinstance(pid, int):
            continue

        heartbeat_at = record.get("heartbeat_at")
        heartbeat_age: float | None = None
        heartbeat_fresh: bool | None = None
        if isinstance(heartbeat_at, str):
            ts = _parse_iso(heartbeat_at)
            if ts is not None:
                heartbeat_age = (now - ts).total_seconds()
                heartbeat_fresh = heartbeat_age <= freshness

        probe = AgentProbe(
            run_id=run_id,
            handoff_id=heartbeat_file.stem.split("--")[1] if "--" in heartbeat_file.stem else "?",
            role=record.get("role", "?"),
            depth=int(record.get("depth", 0)),
            pid=pid,
            heartbeat_at=heartbeat_at,
            heartbeat_age_seconds=heartbeat_age,
        )
        probe.verification.watchdog_heartbeat_fresh = heartbeat_fresh

        proc, kill, cmdline = _probe_proc(pid)
        probe.verification.proc_pid_exists = proc
        probe.verification.kill_0_succeeded = kill
        probe.verification.cmdline_matches_pi = cmdline

        probe.finalize_verdict()
        probes.append(probe)

    return probes


def _active_run_ids(runs_dir: Path) -> list[str]:
    """Runs whose most recent event is not terminal."""
    if not runs_dir.is_dir():
        return []
    out: list[str] = []
    for child in sorted(runs_dir.iterdir()):
        if not child.is_dir() or child.name == "_spool":
            continue
        events_dir = child / "events"
        if not events_dir.is_dir():
            continue
        # A run is "active" if it has a run_started but no run_finished.
        has_started = any("run_started" in e.name for e in events_dir.iterdir())
        has_finished = any("run_finished" in e.name for e in events_dir.iterdir())
        if has_started and not has_finished:
            out.append(child.name)
    return out


def _exit_code_for(probes: list[AgentProbe]) -> int:
    if not probes:
        return 3
    if any(p.verdict == "DEAD" for p in probes):
        return 1
    if any(p.verdict == "UNKNOWN" for p in probes):
        return 2
    return 0


def _render_human(probes: list[AgentProbe]) -> str:
    if not probes:
        return "no active agents found"
    by_run: dict[str, list[AgentProbe]] = {}
    for p in probes:
        by_run.setdefault(p.run_id, []).append(p)

    lines: list[str] = []
    for run_id, run_probes in by_run.items():
        lines.append(run_id)
        for p in sorted(run_probes, key=lambda x: (x.depth, x.handoff_id)):
            verified = ",".join(p.verification.passed_signals()) or "none"
            if p.heartbeat_age_seconds is not None:
                hb = f"heartbeat={p.heartbeat_at} ({p.heartbeat_age_seconds:.0f}s ago)"
            else:
                hb = "heartbeat=none"
            lines.append(
                f"  {p.handoff_id:<25} pid={p.pid:<7} {p.verdict:<8} {hb:<48} verified=[{verified}]"
            )
    return "\n".join(lines)


def _render_json(probes: list[AgentProbe]) -> str:
    payload = {
        "schema_version": 1,
        "generated_at": _now_utc().isoformat(),
        "agents": [
            {
                "run_id": p.run_id,
                "handoff_id": p.handoff_id,
                "role": p.role,
                "depth": p.depth,
                "pid": p.pid,
                "verdict": p.verdict,
                "heartbeat_at": p.heartbeat_at,
                "heartbeat_age_seconds": p.heartbeat_age_seconds,
                "verification": {
                    "proc_pid_exists": p.verification.proc_pid_exists,
                    "kill_0_succeeded": p.verification.kill_0_succeeded,
                    "cmdline_matches_pi": p.verification.cmdline_matches_pi,
                    "watchdog_heartbeat_fresh": p.verification.watchdog_heartbeat_fresh,
                },
            }
            for p in probes
        ],
    }
    return json.dumps(payload, indent=2)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0] if __doc__ else "agent-status")
    parser.add_argument("--run-id", help="probe only this run")
    parser.add_argument("--pid", type=int, help="probe only this pid")
    parser.add_argument("--runs-dir", default=os.environ.get("CODEFLOW_RUNS_DIR", ".codeflow/runs/code"))
    parser.add_argument("--format", choices=["human", "json"], default="human")
    parser.add_argument("--freshness", type=float, default=DEFAULT_FRESHNESS_SECONDS)
    args = parser.parse_args(argv)

    runs_dir = Path(args.runs_dir)
    if not runs_dir.is_dir():
        print(f"agent-status: runs dir not found: {runs_dir}", file=sys.stderr)
        return 3

    if args.pid is not None:
        # Probe a single pid directly; no liveness lookup.
        probe = AgentProbe(
            run_id=args.run_id or "?",
            handoff_id="?",
            role="?",
            depth=0,
            pid=args.pid,
        )
        proc, kill, cmdline = _probe_proc(args.pid)
        probe.verification.proc_pid_exists = proc
        probe.verification.kill_0_succeeded = kill
        probe.verification.cmdline_matches_pi = cmdline
        probe.finalize_verdict()
        probes = [probe]
    elif args.run_id:
        probes = _scan_liveness(runs_dir, args.run_id, args.freshness)
    else:
        probes = []
        for run_id in _active_run_ids(runs_dir):
            probes.extend(_scan_liveness(runs_dir, run_id, args.freshness))

    if args.format == "json":
        print(_render_json(probes))
    else:
        print(_render_human(probes))

    return _exit_code_for(probes)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
