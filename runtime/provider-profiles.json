{
  "providers": {
    "merouter": {
      "name": "MeRouter",
      "baseUrlEnv": "MEROUTER_BASE_URL",
      "apiKeyEnv": "MEROUTER_API_KEY",
      "api": "anthropic-messages",
      "models": [
        {
          "id": "claude-opus-5",
          "name": "Claude Opus 5",
          "reasoning": true,
          "thinkingLevelMap": {
            "xhigh": "xhigh",
            "max": "max"
          },
          "input": ["text", "image"],
          "cost": {
            "input": 5,
            "output": 25,
            "cacheRead": 0.5,
            "cacheWrite": 6.25
          },
          "contextWindow": 1000000,
          "maxTokens": 128000,
          "compat": {
            "forceAdaptiveThinking": true,
            "supportsTemperature": false,
            "supportsStrictTools": true
          }
        }
      ]
    }
  }
}
